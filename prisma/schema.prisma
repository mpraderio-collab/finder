generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  price       Int // precio de venta, en pesos ARS enteros (sin centavos)
  costPrice   Int? // precio de costo — interno, nunca se muestra en la tienda
  stock       Int      @default(0)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Promoción por cantidad (ej: "llevando 2, $45.000") — ambos null si el
  // producto no tiene promo. Se aplica por cada grupo completo de
  // promoQuantity unidades; el resto se cobra al precio normal.
  promoQuantity Int?
  promoPrice    Int?

  images   ProductImage[]
  variants ProductVariant[]
  features ProductFeature[]
  reviews  Review[]
  orderItems OrderItem[]
  stockNotifications StockNotification[]
  purchases Purchase[]

  @@index([status])
}

// Una fila por compra a proveedor (normalmente importada desde un Excel).
// Todos los campos en USD/pesos son los que ya trae la planilla del
// proveedor — no se recalculan acá, se guardan tal cual para mantener el
// mismo desglose que ve el usuario en su Excel.
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  note      String?
  createdAt DateTime @default(now())

  purchases Purchase[]

  @@index([name])
}

model Purchase {
  id          String    @id @default(cuid())
  product     Product?  @relation(fields: [productId], references: [id])
  productId   String?
  // Nombre tal cual figura en la compra — se conserva aunque no haya
  // producto vinculado (producto todavía no dado de alta en el catálogo).
  productName String
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierId  String?
  purchaseDate DateTime

  quantity      Int
  unitPriceUsd  Float // "P Unitario"
  exchangeRate  Float // "Cotización" del dólar ese día

  taxesPesos Float? // "Impuestos en Pesos" — total del lote
  taxesUsd   Float? // "Impuestos USD" — total del lote
  netUsd     Float? // "Neto" = P Unitario × Cantidad
  totalUsd   Float? // "Total" = Impuestos USD + Neto

  unitCostUsd         Float? // "Costo Unitario" (USD, sin envío)
  shippingCostUsd      Float? // "Costo Envío" — total del lote
  unitShippingCostUsd Float? // "Costo Unitario Envío"
  unitCostUsdFinal    Float? // "Costo Neto Unitario" (USD, con envío)

  unitCostPesos  Int  // "Costo en Pesos" — lo que se usa como costPrice del producto
  suggestedPrice Int? // "Precio de Venta" sugerido por la planilla

  // Si esta compra ya estaba reflejada en el stock/costo del producto antes
  // de cargarse acá (por ejemplo, una compra vieja cargada a mano), queda en
  // true para no volver a sumarla si se reprocesa el Excel.
  appliedToStock Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([purchaseDate])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  alt       String  @default("")
  position  Int     @default(0)
  isHero    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  swatch    String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  images VariantImage[]

  @@index([productId])
}

model VariantImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  position  Int     @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String

  @@index([variantId])
}

model ProductFeature {
  id        String  @id @default(cuid())
  text      String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int
  text      String
  isMocked  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([email])
  @@index([name])
}

model Order {
  id                String      @id @default(cuid())
  // cart (carrito online sin terminar) | draft (venta manual sin confirmar)
  // | pending | paid | failed | cancelled | shipped
  status            String      @default("pending")
  channel           String      @default("online") // online (checkout web) | manual (venta cargada a mano)
  note              String?     // solo para ventas manuales
  // Id anónimo del visitante (ver getSessionId en lib/analytics.ts) — solo
  // se usa mientras el pedido online sigue en estado "cart", para poder
  // encontrar y actualizar el mismo carrito en vez de duplicarlo.
  sessionId         String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerId        String?
  customerName      String      @default("")
  customerEmail     String      @default("")
  customerPhone     String      @default("")
  shippingAddress   String      @default("")
  shippingCity      String      @default("")
  shippingProvince  String      @default("")
  shippingZip       String      @default("")
  shippingMethod    String?     // "correo" | "oca" — solo pedidos online
  shippingCost      Int         @default(0)
  trackingCode      String?
  subtotal          Int
  total             Int
  mpPreferenceId    String?
  mpPaymentId       String?     @unique
  mpStatusDetail    String?
  idempotencyKey    String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([customerEmail])
  @@index([sessionId])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  quantity    Int
  unitPrice   Int
  lineTotal   Int? // total real cobrado por esta línea (con promo aplicada si corresponde) — null en pedidos de antes de este campo, ahí vale unitPrice * quantity
  variantName String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productId], references: [id])
  productId   String

  @@index([orderId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String // "page_view" | "add_to_cart" | "purchase"
  path        String?
  productId   String?
  productName String?
  value       Int? // precio (add_to_cart) o total del pedido (purchase), en pesos
  sessionId   String? // id anónimo por visitante, guardado en localStorage
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, email])
  @@index([productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Configuración global del sitio — una sola fila (id fijo "singleton").
model SiteSettings {
  id           String   @id @default("singleton")
  installments Int      @default(6) // cantidad de cuotas que se muestra en el sitio (home y ficha de producto)
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
