generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  price       Int // precio de venta, en pesos ARS enteros (sin centavos)
  costPrice   Int? // precio de costo — interno, nunca se muestra en la tienda
  stock       Int      @default(0)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images   ProductImage[]
  variants ProductVariant[]
  features ProductFeature[]
  specs    ProductSpec[]
  reviews  Review[]
  orderItems OrderItem[]
  stockNotifications StockNotification[]
  purchaseItems PurchaseItem[]
  promotions Promotion[]

  @@index([status])
  mlListings   MlListing[]
  mlOrderItems MlOrderItem[]
}

// Promoción combinable entre uno o varios productos (mix and match): las
// cantidades (o los montos, según triggerType) de todos los productos
// incluidos se suman para ver a qué tramo llega el cliente. Por convención
// de la app, un producto participa en como máximo una promoción activa a
// la vez (se valida al guardar, no a nivel de base).
model Promotion {
  id          String   @id @default(cuid())
  name        String
  // "quantity": los tramos son cantidad de unidades combinadas.
  // "amount": los tramos son el monto total combinado, en pesos.
  triggerType String   @default("quantity")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  tiers    PromotionTier[]

  @@index([active])
}

// Un tramo: al alcanzar `threshold` (unidades o pesos, según
// Promotion.triggerType) se aplica `percentOff` sobre el total de todas
// las unidades de los productos de la promo presentes en el pedido.
model PromotionTier {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  threshold   Int
  percentOff  Float

  @@unique([promotionId, threshold])
  @@index([promotionId])
}

// Código de descuento que el cliente tipea en el checkout (distinto de
// Promotion, que es automática por producto/cantidad) — se aplica sobre el
// subtotal ya con promociones, antes del envío.
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique // se guarda en mayúsculas, se compara sin importar mayúsculas/minúsculas
  percentOff Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([active])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  note      String?
  createdAt DateTime @default(now())

  purchases Purchase[]

  @@index([name])
}

// Una compra a proveedor — puede tener varias líneas de producto (ver
// PurchaseItem). El desglose de costos vive en cada línea porque la
// cotización/impuestos/envío pueden variar por lote dentro de la misma
// compra.
model Purchase {
  id           String    @id @default(cuid())
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  supplierId   String?
  purchaseDate DateTime

  // draft (borrador/presupuesto) | confirmed (pedido al proveedor) |
  // received (llegó — acá se suma el stock y se actualiza el costo de cada
  // línea) | cancelled. Solo se puede editar libremente mientras es draft.
  status String @default("draft")

  createdAt DateTime @default(now())

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
}

// Una línea de producto dentro de una compra — una compra puede tener
// varios productos (ver PurchaseForm), cada uno con su propio desglose de
// costos porque la cotización/impuestos/envío pueden variar por lote.
model PurchaseItem {
  id          String    @id @default(cuid())
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId  String
  product     Product?  @relation(fields: [productId], references: [id])
  productId   String?
  productName String

  quantity     Int
  unitPriceUsd Float // "P Unitario"
  exchangeRate Float // "Cotización" del dólar ese día

  taxesPesos Float? // "Impuestos en Pesos" — total del lote
  taxesUsd   Float? // "Impuestos USD" — total del lote
  netUsd     Float? // "Neto" = P Unitario × Cantidad
  totalUsd   Float? // "Total" = Impuestos USD + Neto

  unitCostUsd         Float? // "Costo Unitario" (USD, sin envío)
  shippingCostUsd      Float? // legado: "Costo Envío" total del lote, cargado a mano — reemplazado por el cálculo volumétrico (ver boxShippingCostUsd). Se conserva solo para compras viejas.
  unitShippingCostUsd Float? // legado — ver shippingCostUsd
  unitCostUsdFinal    Float? // "Costo Neto Unitario" (USD) = unitCostUsd + (boxShippingCostUsd ÷ quantity) — el envío de la caja de ESTA línea sí se prorratea por unidad acá (a diferencia del total de la compra, que lo suma una sola vez)

  // Envío por volumen: costo de envío de la línea = volumen de UNA caja
  // (ancho × largo × alto) × costo por m³ del lote (costPerCubicMeterUsd,
  // mismo valor en todas las líneas de la compra) × cantidad de cajas
  // (boxCount).
  boxWidthM            Float? // "Ancho caja (m)"
  boxLengthM           Float? // "Largo caja (m)"
  boxHeightM           Float? // "Alto caja (m)"
  // Cuántas unidades entran en la caja llena — si esta línea trae menos
  // (la caja no viene completa), el volumen se prorratea por cantidad ÷
  // capacidad antes de calcular el envío (ver boxShippingCostUsd).
  boxCapacityUnits     Int?
  boxCount             Int? // cantidad de cajas iguales de esta línea
  costPerCubicMeterUsd Float? // "Costo por m³ (USD)" — dato del lote
  boxShippingCostUsd   Float? // ancho × largo × alto × (cantidad ÷ capacidad de la caja) × cantidad de cajas × costo por m³

  unitCostPesos  Int     // "Costo en Pesos" — lo que se usa como costPrice del producto
  suggestedPrice Int?    // "Precio de Venta" sugerido por la planilla
  referenceUrl   String? // link de referencia al producto en el sitio del proveedor
  // Solo para líneas sin producto vinculado (subida a mano) — si la línea
  // está vinculada a un producto, se muestra la foto principal de ese
  // producto en vez de esta.
  imageUrl       String?

  @@index([purchaseId])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  alt       String  @default("")
  position  Int     @default(0)
  isHero    Boolean @default(false)
  // Fotos que se muestran en el carrusel del home (las de ambiente quedan
  // bien de fondo; las infografías con texto no).
  showInCarousel Boolean @default(false)
  // Dónde está la luz en la foto, en % (0-100) desde la esquina superior
  // izquierda — el carrusel del home la centra. Se calcula al marcar la
  // foto para el carrusel; sin dato, se centra la foto entera.
  focusX    Float?
  focusY    Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  swatch    String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  images VariantImage[]

  @@index([productId])
}

model VariantImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  position  Int     @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String

  @@index([variantId])
}

model ProductFeature {
  id        String  @id @default(cuid())
  text      String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

// Ficha técnica: pares etiqueta / valor (ej: "Batería" / "1200 mAh").
model ProductSpec {
  id        String  @id @default(cuid())
  label     String
  value     String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int
  text      String
  photoUrl  String? // foto opcional que adjunta el cliente al dejar la reseña
  // Reseñas de siembra (isMocked=true) ya nacen aprobadas; las que dejan
  // clientes reales (isMocked=false) arrancan sin aprobar hasta que un
  // admin las revisa en /admin/reviews — recién ahí se muestran en la tienda.
  approved  Boolean  @default(true)
  isMocked  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
  @@index([approved])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([email])
  @@index([name])
}

model Order {
  id                String      @id @default(cuid())
  // cart (carrito online sin terminar) | draft (venta manual sin confirmar)
  // | pending | paid | failed | cancelled | shipped
  status            String      @default("pending")
  channel           String      @default("online") // online (checkout web) | manual (venta cargada a mano)
  note              String?     // solo para ventas manuales
  // Id anónimo del visitante (ver getSessionId en lib/analytics.ts) — solo
  // se usa mientras el pedido online sigue en estado "cart", para poder
  // encontrar y actualizar el mismo carrito en vez de duplicarlo.
  sessionId         String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerId        String?
  customerName      String      @default("")
  customerEmail     String      @default("")
  customerPhone     String      @default("")
  shippingAddress   String      @default("")
  shippingCity      String      @default("")
  shippingProvince  String      @default("")
  shippingZip       String      @default("")
  shippingMethod    String?     // "correo" | "oca" — solo pedidos online
  shippingCost      Int         @default(0)
  // Independiente de `status`: una venta manual puede estar confirmada y
  // hasta enviada sin haberse cobrado todavía (fiado). Los pedidos online
  // siempre nacen pagados de verdad (el status "paid" ya implica que
  // Mercado Pago acreditó el cobro), así que quedan en true sin uso.
  isPaid            Boolean     @default(true)
  trackingCode      String?
  // Lo que realmente cuesta despachar este pedido (no lo que se le cobra
  // al cliente, que suele ser $0 por envío gratis) — solo aplica cuando el
  // pedido se envía suelto; si es parte de un Shipment agrupado, el costo
  // real vive ahí (Shipment.actualShippingCost) y este campo se ignora.
  actualShippingCost Int?
  // Cupón de descuento tipeado en el checkout (ver model Coupon) — distinto
  // de Promotion. couponDiscount ya está restado de `total`; `subtotal`
  // sigue siendo el monto con promociones pero SIN el cupón, para no romper
  // reportes que ya asumen ese significado.
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  couponDiscount    Int         @default(0)
  subtotal          Int
  total             Int
  mpPreferenceId    String?
  mpPaymentId       String?     @unique
  mpStatusDetail    String?
  idempotencyKey    String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items    OrderItem[]
  shipment Shipment?   @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  @@index([status])
  @@index([customerEmail])
  @@index([sessionId])
  @@index([customerId])
  @@index([shipmentId])
}

// Agrupa varios pedidos (web o manuales, de distintos clientes) que salen
// juntos en un mismo despacho — para marcarlos todos como "Enviado" de una
// y dejar registro de con qué transporte/código salieron.
model Shipment {
  id             String   @id @default(cuid())
  shippingMethod String? // texto libre: "Correo Argentino", "Moto propia", etc.
  trackingCode   String?
  note           String?
  // Lo que realmente costó el despacho combinado (una sola factura del
  // transportista cubriendo todos los pedidos agrupados acá).
  actualShippingCost Int?
  createdAt      DateTime @default(now())

  orders Order[]
}

model OrderItem {
  id          String  @id @default(cuid())
  quantity    Int
  unitPrice   Int
  lineTotal   Int? // total real cobrado por esta línea (con promo aplicada si corresponde) — null en pedidos de antes de este campo, ahí vale unitPrice * quantity
  variantName String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productId], references: [id])
  productId   String

  @@index([orderId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String // "page_view" | "add_to_cart" | "purchase"
  path        String?
  productId   String?
  productName String?
  value       Int? // precio (add_to_cart) o total del pedido (purchase), en pesos
  sessionId   String? // id anónimo por visitante, guardado en localStorage
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, email])
  @@index([productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Configuración global del sitio — una sola fila (id fijo "singleton").
model SiteSettings {
  id           String   @id @default("singleton")
  installments Int      @default(6) // cantidad de cuotas que se muestra en el sitio (home y ficha de producto)
  // % del precio de venta que se estima de impuestos/retenciones en las ventas
  // de Mercado Libre (la API no siempre los desglosa) — se usa para el margen.
  mlTaxPercent Float    @default(5)
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Mercado Libre
// ---------------------------------------------------------------------------

// Vínculo entre una publicación de Mercado Libre y un producto de Finder:
// con esto se sabe a qué producto (y a qué costo) corresponde cada venta.
model MlListing {
  id          String   @id @default(cuid())
  mlItemId    String   @unique // "MLA1234567890"
  title       String   @default("")
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName String? // si la publicación es de un color / variante puntual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

// Venta importada de Mercado Libre. Va aparte de Order porque trae datos
// propios (comisión, envío a cargo del vendedor) y puede tener publicaciones
// todavía sin vincular a un producto.
model MlOrder {
  id                 String        @id @default(cuid())
  mlOrderId          String        @unique
  status             String // estado de la orden en ML: paid, cancelled, etc.
  dateCreated        DateTime
  buyerNickname      String        @default("")
  totalAmount        Int // suma de los productos, ARS
  sellerShippingCost Int           @default(0) // envío que paga el vendedor
  shipmentId         String?
  items              MlOrderItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([dateCreated])
}

model MlOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       MlOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mlItemId    String
  title       String   @default("")
  quantity    Int
  unitPrice   Int
  saleFee     Int      @default(0) // comisión total de ML por esta línea (ya multiplicada por la cantidad)
  // Se completan al importar si la publicación está vinculada; si no, quedan
  // vacíos y se resuelven apenas se vincula.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantName String?

  @@index([orderId])
  @@index([mlItemId])
  @@index([productId])
}
