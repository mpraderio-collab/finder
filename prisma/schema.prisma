generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  price       Int // precio de venta, en pesos ARS enteros (sin centavos)
  costPrice   Int? // precio de costo — interno, nunca se muestra en la tienda
  stock       Int      @default(0)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Promoción por cantidad (ej: "llevando 2, $45.000") — ambos null si el
  // producto no tiene promo. Se aplica por cada grupo completo de
  // promoQuantity unidades; el resto se cobra al precio normal.
  promoQuantity Int?
  promoPrice    Int?

  images   ProductImage[]
  variants ProductVariant[]
  features ProductFeature[]
  reviews  Review[]
  orderItems OrderItem[]
  stockNotifications StockNotification[]

  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  alt       String  @default("")
  position  Int     @default(0)
  isHero    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  swatch    String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  images VariantImage[]

  @@index([productId])
}

model VariantImage {
  id        String  @id @default(cuid())
  url       String
  type      String  @default("image") // "image" | "video"
  position  Int     @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String

  @@index([variantId])
}

model ProductFeature {
  id        String  @id @default(cuid())
  text      String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int
  text      String
  isMocked  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Order {
  id                String      @id @default(cuid())
  status            String      @default("pending") // pending | paid | failed | cancelled | shipped
  channel           String      @default("online") // online (checkout web) | manual (venta cargada a mano)
  note              String?     // solo para ventas manuales
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  shippingCity      String
  shippingProvince  String
  shippingZip       String
  shippingMethod    String?     // "correo" | "oca" — solo pedidos online
  shippingCost      Int         @default(0)
  trackingCode      String?
  subtotal          Int
  total             Int
  mpPreferenceId    String?
  mpPaymentId       String?     @unique
  mpStatusDetail    String?
  idempotencyKey    String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id          String  @id @default(cuid())
  quantity    Int
  unitPrice   Int
  lineTotal   Int? // total real cobrado por esta línea (con promo aplicada si corresponde) — null en pedidos de antes de este campo, ahí vale unitPrice * quantity
  variantName String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productId], references: [id])
  productId   String

  @@index([orderId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String // "page_view" | "add_to_cart" | "purchase"
  path        String?
  productId   String?
  productName String?
  value       Int? // precio (add_to_cart) o total del pedido (purchase), en pesos
  sessionId   String? // id anónimo por visitante, guardado en localStorage
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, email])
  @@index([productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Configuración global del sitio — una sola fila (id fijo "singleton").
model SiteSettings {
  id           String   @id @default("singleton")
  installments Int      @default(6) // cantidad de cuotas que se muestra en el sitio (home y ficha de producto)
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
